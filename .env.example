# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes
BETTER_AUTH_URL=http://localhost:3000
SMTP_URL=
EMAIL_FROM=

# Supabase PostgreSQL - Session Pooler
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Supabase (keep these if your app still uses Supabase for data access)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
