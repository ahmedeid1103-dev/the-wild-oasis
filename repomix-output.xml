<file path="app/lib/data-service.ts">
import { cacheLife, cacheTag } from "next/cache";

import { capacityRanges, type CabinFilter } from "./data";
import type { Cabin } from "../types/cabin";
import { supabase } from "./supabase/client";

export async function getCabins(filter: CabinFilter = "all"): Promise<Cabin[]> {
  "use cache";
  const startedAt = performance.now();
  cacheLife("hours");
  cacheTag("cabins");

  let query = supabase
    .from("cabins")
    .select(
      "id, name, maxCapacity, regularPrice, discount, image, description, cabin_number",
    );

  if (filter !== "all") {
    const [minCapacity, maxCapacity] = capacityRanges[filter];
    query = query
      .gte("maxCapacity", minCapacity)
      .lte("maxCapacity", maxCapacity);
  }

  const queryStartedAt = performance.now();
  const { data, error } = await query;
  const queryDurationMs = performance.now() - queryStartedAt;

  console.info(
    "[cabin-perf]",
    JSON.stringify({
      event: "supabase-query-complete",
      filter,
      durationMs: Number(queryDurationMs.toFixed(1)),
    }),
  );

  if (error) {
    throw new Error("Cabins could not be loaded");
  }

  const cabins = data.map((cabin) => ({
    ...cabin,
    cabinNumber: cabin.cabin_number,
  }));

  console.info(
    "[cabin-perf]",
    JSON.stringify({
      event: "getCabins-cache-function-complete",
      filter,
      durationMs: Number((performance.now() - startedAt).toFixed(1)),
    }),
  );

  return cabins;
}

export async function getCabin(cabinId: string): Promise<Cabin | null> {
  "use cache";
  cacheLife("hours");
  cacheTag("cabins", `cabin-${cabinId}`);

  const { data, error } = await supabase
    .from("cabins")
    .select("*")
    .eq("id", cabinId)
    .maybeSingle();

  if (error) {
    throw new Error("Cabin could not be loaded");
  }

  if (!data) {
    return null;
  }

  return {
    ...data,
    cabinNumber: data.cabin_number,
  };
}
</file>

<file path="app/lib/data.ts">
import type { CabinFilter } from "../types/cabin";

export type { CabinFilter } from "../types/cabin";

export const capacityRanges: Record<
  Exclude<CabinFilter, "all">,
  readonly [number, number]
> = {
  "2-3": [2, 3],
  "4-7": [4, 7],
  "8-12": [8, 12],
};

export function isCapacityFilter(
  value: unknown,
): value is Exclude<CabinFilter, "all"> {
  return (
    typeof value === "string" &&
    Object.prototype.hasOwnProperty.call(capacityRanges, value)
  );
}
